# ============================================================
#  RecetaYa - auth-service
#  Archivo de EJEMPLO de variables de entorno (sin valores reales)
#
#  Uso:
#    1. copia este archivo:   cp .env.example .env
#    2. completa los valores en .env
#
#  IMPORTANTE: .env está en .gitignore y NUNCA se sube al repositorio.
#  docker-compose.yml lee .env automáticamente; para correr en local
#  (./mvnw spring-boot:run) puedes exportar las mismas variables.
# ============================================================

# ---------- Base de datos PostgreSQL ----------
# 5433 es el puerto que publica docker-compose (5433:5432) para acceder al
# contenedor auth-db-v2 desde tu equipo. Si usas un PostgreSQL propio en local,
# cámbialo a 5432.
DB_URL=jdbc:postgresql://localhost:5433/auth_db
DB_USERNAME=postgres
DB_PASSWORD=cambia_esta_password

# ---------- JWT ----------
# Obligatorio: mínimo 32 caracteres (se usa para firmar con HS256)
JWT_SECRET=cambia_esta_clave_secreta_de_32_o_mas_caracteres
# Access token: 15 minutos
JWT_EXPIRATION_MS=900000
# Refresh token: 7 días
JWT_REFRESH_EXPIRATION_MS=604800000
